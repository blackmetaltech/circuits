{
  "name": "circuits",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bridge": "vite build -c vite.bridge.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "vite build -c vite.bridge.config.ts && godot --headless --path godot --import >/dev/null 2>&1; CB_SMOKE=1 godot --headless --path godot",
    "bench:lu": "node --experimental-strip-types scripts/bench-lu.ts",
    "bench:cost": "vite build -c vite.cost.config.ts --logLevel error && node node_modules/.cache/bench-cost/bench-cost.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
