class_name CoachData
extends RefCounted
## Wren's coach steps for chapter 1 (DESIGN §7.1 style): each step is {text, target, done, when?}. `done` / `when` are condition ids the
## backend answers (FixtureBench.cond; the engine's coachStep query later). A step is shown while its `when` holds (default: always) and its
## `done` does not; the first such step is the current one. `target` names the bench object the hand-drawn arrow points at:
## box | board | pad:IN | rocker | scope | dmm | customer | notebook | tin | none.

const STEPS := {
	"1-1": [
		{"when": "smoked", "done": "r_in_loop", "target": "box", "text": "Pop. It drew 0.60 A and a red LED is rated 0.03 A. Something has to limit the current. Pull the burnt LED out (drag it back to the box or right-click it), then put a resistor in the loop."},
		{"done": "led_placed", "target": "box", "text": "Lio's torch is dead. Light the LED without burning it. Drag the LED out of the shoebox onto the board."},
		{"done": "wired", "target": "pad:IN", "text": "The longer leg is +. Draw a wire from the IN tab to the LED's long leg, and another from its short leg back to GND."},
		{"done": "powered", "target": "rocker", "text": "Flip the rocker on the battery holder (or press Space) to power it up."},
		{"when": "lit", "done": "dmm_used", "target": "dmm", "text": "See the dots? Their speed is the current. Drag the DMM's probe tips onto the LED's two legs and set the dial to mA: the ticket wants 10 to 20 mA."},
		{"done": "locked", "target": "scope", "text": "Hold the trace inside the amber band. When it sits there for a moment the band locks."},
		{"done": "never", "target": "customer", "text": "That's the job. The notebook has the next ticket."},
	],
	"1-2": [
		{"when": "smoked", "done": "clean", "target": "box", "text": "Smoke again. Pull the burnt part out and think about how the current splits."},
		{"done": "leds3", "target": "box", "text": "Ash wants three LEDs on one 9 V battery. Drag three LEDs onto the board."},
		{"done": "r_in_loop", "target": "board", "text": "One resistor protects them. Put all three LEDs in series with it: the same current flows through each, 14 to 20 mA."},
		{"done": "powered", "target": "rocker", "text": "Flip the rocker."},
		{"done": "locked", "target": "scope", "text": "Lock the band. E12 neighbours fail on both sides, so choose with the equation: R = (9 - 3 x 2.0) / 0.0165."},
		{"done": "never", "target": "customer", "text": "Now they see her coming."},
	],
	"1-3": [
		{"when": "smoked", "done": "clean", "target": "box", "text": "Burnt. A resistor's watt rating is a promise about heat. Pull it out, and pick one with more watts."},
		{"done": "r_placed", "target": "box", "text": "Mr. Brook's heater (50 ohm, fixed on the board) wants 8 V of the 12 V supply. A series resistor will drop the rest. Pick one from the box."},
		{"done": "powered", "target": "rocker", "text": "Flip the rocker. Watch the part: a hot resistor glows, and Rezzy notices."},
		{"done": "locked", "target": "scope", "text": "8 V across the heater, and no part over its rating. Cheaper is better, but a 1/4 W resistor will not survive this."},
		{"done": "never", "target": "customer", "text": "The fish thank you."},
	],
	"1-4": [
		{"done": "dmm_used", "target": "dmm", "text": "The battery is tired. Put the DMM's red probe on IN, the black one on GND, dial on V, and read its voltage with nothing connected."},
		{"done": "r_placed", "target": "box", "text": "Now load it with a resistor from the box. The voltage will sag: that sag is the internal resistance."},
		{"done": "powered", "target": "rocker", "text": "Flip the rocker."},
		{"done": "locked", "target": "scope", "text": "Most power goes into the load when R matches the battery's own r. The ticket wants 4.2 W; a 1 W part will not survive."},
		{"done": "never", "target": "customer", "text": "Vroom."},
	],
	"1-5": [
		{"done": "built", "target": "box", "text": "Predict first: what is V(A)? Then build it: E1 with R1 (2) and E2 with R2 (3) meeting at A, with R3 (6) to ground."},
		{"done": "powered", "target": "rocker", "text": "Flip the switch and probe node A."},
		{"done": "locked", "target": "scope", "text": "Was your prediction right? The bench checks V(A) to 0.1 %."},
		{"done": "never", "target": "customer", "text": "Predict, then probe."},
	],
}

const CODEX := [
	{"title": "Ohm's law", "eq": "V = I x R", "body": "Volts across a resistor push amps through it. But an LED keeps about 2 V for itself, so the resistor only gets what is left: (9 V - 2 V) over 470 ohm is 14.9 mA, which is what the scope reads. Forget the LED's 2 V and you would say 19 mA (9 over 470): the gap is the LED. Nothing to memorise: it is just division."},
	{"title": "An LED needs a limit", "eq": "R = (V - Vf) / I", "body": "A red LED drops about 2 V whatever the current, and is rated 30 mA. The battery's 9 V minus that 2 V must fall across something that limits the current to 10 to 20 mA. With nothing there, only the battery's own tiny resistance limits it and the die cracks. That is the smoke."},
	{"title": "Every resistor is a promise about heat", "eq": "P = I x I x R", "body": "A quarter-watt resistor that dissipates half a watt glows, then smokes. Choose the watts before you power on."},
	{"title": "Power, three ways", "eq": "P = VI = I\u00b2R = V\u00b2/R", "body": "Watts are volts times amps. With Ohm's law that is also I squared times R (use it when the current is known) or V squared over R (when the volts are). A rating is the most power a part may turn into heat. A source gives a load its most power when the load R equals the source's own r: that is the 1-4 trick."},
	{"title": "Tired batteries", "eq": "V = E - I x r", "body": "A battery is a perfect source with a small resistor inside. The tired ones have a bigger r, so the voltage sags under load. Most power goes into a load equal to r."},
	{"title": "The critters", "eq": "speed ~ log(I)", "body": "The critters' speed shows how much current flows: faster means more amps (each 10x of current is one notch faster), and they are always spaced the same."},
	{"title": "Node voltage: one equation", "eq": "sum (E - A) / R = A / R3", "body": "Call the junction A and write the currents into it: (10 - A)/2 + (5 - A)/3 = A/6. One unknown, so solve it: A = 6.667 V. A battery whose volts are lower than A is being charged (current flows INTO it); a higher one discharges. Check the sign of each current."},
	{"title": "Kirchhoff, two sentences", "eq": "sum of I at a node = 0", "body": "Whatever flows into a node flows out. Around any loop the voltages add to zero. Two batteries meeting at a node: one may be charging the other."},
	{"title": "The voltage divider", "eq": "Vout = Vin x R2 / (R1 + R2)", "body": "Two resistors in series share the voltage in proportion to their sizes: the same current flows through both, so the bigger resistor takes the bigger share. The output is taken from the middle, across R2. This is how a 9 V supply becomes the 3.3 V a sensor wants, as long as nothing else is connected to the middle."},
	{"title": "A load is part of the divider", "eq": "Vout = Vin x (R2 || RL) / (R1 + R2 || RL)", "body": "Whatever you connect to OUT sits in parallel with R2. The ADC's 10 kilohm and your R2 together are smaller than R2 alone, so the output sags below the unloaded formula: 5.6 k over 3.3 k looks like 3.34 V on paper and is 2.76 V with the ADC attached. Count the load in as a resistor, or make R2 much smaller than the load (but then the divider wastes power: that is the second star)."},
	{"title": "Thevenin and Norton", "eq": "Vth = Voc     Rth = Voc / Isc", "body": "Any network seen from two terminals behaves like one source and one resistor. Measure the open-circuit voltage (nothing connected): that is the source. Measure the short-circuit current (the meter on mA straight across): the volts divided by the amps is the resistance. A Norton source is the same thing drawn as a current Isc with Rth across it. The sealed box is 8.00 V behind 1137 ohm, and matching only the voltage is not enough: the series resistance sets how much it sags under load."},
	{"title": "The Wheatstone bridge", "eq": "R / X = l / (100 - l)", "body": "Two resistors in a row form one arm of a bridge, the slide wire is the other. When the galvanometer between the two middle points reads zero, the two ratios are equal: R / X = l / (100 - l), where l is the jockey's distance from R's end. So X = R x (100 - l) / l. The cable's loop resistance is 0.1 ohm per metre, out and back, so d = X / 0.1. No current flows at balance, so the meter's own resistance and the cell's voltage drop out."},
	{"title": "Null methods", "eq": "keep l near 50 cm", "body": "A null reading asks nothing of the meter except 'is it zero?', which is why a bridge is so accurate. Where the null lands matters: reading the jockey to a millimetre is a bigger fraction of l near the ends of the wire than in the middle. Choose R close to X and the balance lands near 50 cm."},
	{"title": "The potentiometer", "eq": "E = k l     r = R (l1 - l2) / l2", "body": "A driver cell sends one current down a long wire, so the voltage along it grows evenly: k volts per cm (4 V through 10 + 10 ohm is 0.2 A, 2 V across 100 cm, k = 0.02 V/cm). A cell balances when the wire's voltage between A and the jockey equals the cell's EMF, with no current drawn from the cell: E = k l1. Shunt the cell with R and it balances at l2, where V = k l2: the missing volts were lost inside, r = R (l1 - l2) / l2. Only the ratio l1 / l2 enters, so a driver cell with some resistance of its own changes k but not the answer."},
	{"title": "Capacitance", "eq": "Q = C V     I = C dV/dt", "body": "A capacitor keeps charge on two plates held close together. Its capacitance C says how many coulombs it holds for every volt across it: a 100 microfarad capacitor at 10 V holds 1 millicoulomb. Current only flows while the voltage across it is changing, I = C x (volts per second), so a capacitor charging from a steady supply starts fast and slows down, and at steady DC it looks like a gap in the wire. The big electrolytic cans (the ones with a stripe) are polarised: the stripe marks the minus leg."},
	{"title": "Capacitors in series and parallel", "eq": "parallel: C = C1 + C2     series: 1/C = 1/C1 + 1/C2", "body": "Side by side, capacitors add: more plate area. In a row they share one charge Q, because the charge that leaves one capacitor must arrive on the next, so the voltage splits the other way round to the capacitances: the SMALLER capacitor takes the bigger voltage. 2 microfarad in series with a 3 and a 6 in parallel (that pair is 9) is 1/2 + 1/9 = 0.611, so 1.636 microfarad: across 110 V that is 180 microcoulombs, and the 2 microfarad has 90 V on it. When a charged capacitor is joined to an empty one, the charge is conserved and the voltage is Q over the total capacitance."},
	{"title": "The time constant", "eq": "tau = R x C", "body": "A capacitor fills through a resistor, and the resistor limits how fast: big R or big C, slow charging. The product R x C, in seconds, is the time constant tau. 10 kilohm and 100 microfarad give 1 second. Everything about the timer follows from tau: after one tau the capacitor has done 63 % of its journey, after two 86 %, after five 99 %. A kilohm times a microfarad is a millisecond, which is the number to carry in your head."},
	{"title": "The charging curve", "eq": "V(t) = Vs (1 - e^(-t / RC))", "body": "The capacitor's voltage chases the supply Vs with a speed proportional to how far it still has to go, so it climbs steeply and then bends over: 63.2 % at t = RC, 86.5 % at 2 RC, 95 % at 3 RC. To find when it crosses a level Vth, t = -RC x ln(1 - Vth / Vs): halfway (Vth = Vs / 2) takes 0.69 RC. Discharging is the mirror image, V0 x e^(-t / RC). The scope's amber tube is exactly this curve, with a little room for the parts not being perfect."},
	{"title": "Your probe is a part of the circuit", "eq": "Vth = Vs Rp / (R + Rp)     Rth = R || Rp", "body": "A scope probe is a 10 megohm resistor to ground. Put it on the node of a 1 megohm timer and the timer's own resistor and the probe's divide the supply: the capacitor now charges toward 9.09 V (not 10 V) through 0.909 megohm, so the 63 % mark arrives later than R x C says. The rule of thumb: keep the resistor in a timer at least ten times, better a hundred times, below whatever you connect to it, and use a bigger capacitor instead. The same thing happened to the divider's load in chapter 2."},
	{"title": "Electrolytic capacitors", "eq": "V stays under the rating, the stripe goes to minus", "body": "An aluminium electrolytic gets its big capacitance from a very thin oxide film that only forms in one direction. Wired backwards it passes current, makes gas and swells its vent top until it pops. Over its voltage rating the same thing happens: the game vents a capacitor that stays above 1.2 times its rating for 50 milliseconds, or more than a volt the wrong way round for half a second. Pick the next rating up with about 30 % margin. Values below 220 microfarad and the 6.3 V part are generic game values, not a datasheet read."},
	{"title": "Filtering a bounce", "eq": "t(half) = 0.69 x R x C", "body": "A switch contact chatters for a millisecond or two when it closes. An RC low-pass turns the burst of edges into one slow slope: while the capacitor is far from the threshold it ignores the chatter. R x C must be much longer than the bounce (so about 10 milliseconds) but short enough that the crossing is still on time (under 20). The two directions are not alike: pressing the button discharges the capacitor through R alone, releasing it charges it through R plus the pull-up resistor, so the release crossing is later."},
	{"title": "A coil's time constant", "eq": "tau = L / R     I(t) = (V / R)(1 - e^(-t R / L))", "body": "A coil resists a change of current, so its current rises like a capacitor's voltage does, with a time constant of L over R. The relay's 100 millihenry and 200 ohm give 0.5 millisecond, too slow for the ticket. A bigger supply with a series resistor aims at the same final current but with a larger R, so tau shrinks: 24 V through 200 + 200 ohm gives 60 mA with tau = 0.25 millisecond, and the relay pulls in at 0.275 ms. The price is the resistor's heat, I squared R: speed costs watts."},
	{"title": "Energy in a capacitor", "eq": "U = 1/2 C V squared = 1/2 Q V", "body": "Charging a capacitor to V stores 1/2 C V squared joules: 9.9 millijoules in the 1.636 microfarad bank at 110 V. Only half the energy the supply gave went into the capacitor while it charged; the other half became heat in the resistor. Join a charged capacitor to an empty one and the same kind of loss happens: 4 microfarad at 100 V holds 20 millijoules, shared over 10 microfarad it settles at 40 V and holds 8 millijoules, and the missing 12 millijoules is heat in the switch and the wires. It is 12 millijoules whatever their resistance: a small R makes a big brief current, a big R a small long one."},
	{"title": "Mains safety and isolation", "eq": "never build on the mains", "body": "On a real bench, mains work needs training, an isolation transformer and a second person in the room. An isolation transformer gives you a secondary that floats: touch one wire and no current finds its way through you to the earth. It does not make the mains safe, only less likely to kill. Here the bench is simulated and the mains side of the board is fenced in red: you build only after the transformer, on the low-voltage side. Nothing in this notebook is a recipe to build at home. A big capacitor can hold its charge for minutes after the plug is out, and it bites."},
	{"title": "RMS and peak", "eq": "Vpeak = 1.414 x Vrms", "body": "A 12 V rms sine heats a resistor as much as 12 V of battery would, but it swings up to 17 V and down to minus 17 V. A rectifier charges its capacitor to the PEAK, not the rms. Mains is quoted in rms too: 230 V rms peaks at 325 V, and a mains that is 10 % high peaks 10 % higher. Capacitor ratings are about peaks."},
	{"title": "The transformer", "eq": "Vs = Vp x Ns / Np", "body": "Two coils on one core: the secondary voltage is the primary voltage times the turns ratio, here 230 : 12, so the primary's 230 V rms becomes 12 V rms. Mains of 207 V gives 10.8 V, mains of 253 V gives 13.2 V: the secondary follows the wall. Its winding has a little resistance (1.5 ohm here), which is why the voltage sags when you draw current."},
	{"title": "Diodes and the bridge", "eq": "two diodes conduct at a time, about 0.8 V each", "body": "A diode passes current one way: the band (cathode) is the end the current goes to. Four of them in a bridge turn both halves of the sine into positive humps, and every hump has to pass through two diodes in series, so about 1.6 V is lost. A diode the wrong way round does not just block: it can join two others across the winding and short it."},
	{"title": "Ripple", "eq": "dV = I / (2 f C)", "body": "The capacitor charges at the peaks and the load drains it in between. With a bridge there are two peaks per cycle, so on 50 Hz the gap is 10 ms: a 100 mA load takes 1 millicoulomb from it, and a 1000 microfarad capacitor drops about 1 V (a little less, since the diodes start refilling early). One diode gives one peak per cycle, so the gap and the ripple double. More capacitance or more current to feed: ripple is I t / C."},
	{"title": "Capacitor ratings and mains tolerance", "eq": "pick the rating for the peak at the highest mains, no load", "body": "With no load nothing takes charge away from the capacitor, so it sits at the full peak. At the mains 10 % high that is 17.5 V in the wall-wart, and a 16 V capacitor is over its rating: it runs warm and bulges. An electrolytic vents above 1.2 times its rating. Leave about 30 % margin, which is why the wall-wart wants a 25 V part."},
	{"title": "The Zener", "eq": "R <= (Vin - Vz) / (IL + Iz)", "body": "A Zener holds nearly the same voltage across it over a wide range of current when it is connected backwards. Feed it through a resistor and it takes whatever current the load does not. Size R for the worst corner at each end: lowest input with the biggest load (the Zener must keep a few milliamps) and highest input with no load (it takes everything and heats: P = Vz x Iz). A real Zener's voltage creeps with current by its dynamic resistance, 7 ohm for a 1N4733A."},
	{"title": "A linear regulator is a heater", "eq": "P = (Vin - Vout) x I     Tj = Ta + P x theta", "body": "A linear regulator holds its output by burning the difference. 15 V in, 5 V out at 0.5 A is 5 W, and a bare TO-220 rises 54 degrees per watt: far past its limit, so it shuts itself off at 150 degrees and tries again, which looks like the output blinking. Lower theta with a heatsink (chip to case 4, pad 0.5, then the sink), or lower P by dropping volts in a power resistor first. The regulator also needs about 2 V of headroom."},
	{"title": "The LM317", "eq": "Vout = 1.25 (1 + R2 / R1) + Iadj R2", "body": "The LM317 keeps 1.25 V between OUT and ADJ, so R1 carries 1.25 V / R1 and R2 carries the same current plus a little (Iadj, about 50 microamps). It also needs a minimum load of a few milliamps: with no load, the bias it pushes into OUT has to go through R1 and R2, and if they are large it raises the output. That is why R1 is 240 ohm: 5.2 mA is more than the minimum."}
]

static func steps(id: String) -> Array: return STEPS.get(id, [])

## Index of the current step for a backend that answers cond(id); -1 when none.
static func current(id: String, backend) -> int:
	var st := steps(id)
	for i in st.size():
		var s: Dictionary = st[i]
		if s.has("when") and not backend.cond(str(s.when)): continue
		if backend.cond(str(s.get("done", "never"))): continue
		return i
	return st.size() - 1 if st.size() > 0 else -1
